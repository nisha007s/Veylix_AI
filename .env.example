# =============================================================
# Veylix AI - example environment configuration
#
# This file contains PLACEHOLDERS ONLY. It is safe to commit.
# To use it: copy it to a file named ".env" (which Git ignores)
# and replace every "change-me" value with your own local value.
# Never put real passwords or keys in this file.
# =============================================================

# ---------- Application ----------
# development | test | production
VEYLIX_APP_ENV=development

# Frontend address allowed to call the API (SRS SEC-031: narrow CORS)
VEYLIX_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- Database (needed from Phase 4) ----------
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
VEYLIX_DATABASE_URL=postgresql+psycopg://veylix_app:change-me@localhost:5432/veylix_dev
VEYLIX_TEST_DATABASE_URL=postgresql+psycopg://veylix_app:change-me@localhost:5432/veylix_test

# ---------- Secrets (generate long random values locally) ----------
# Used to sign/protect sessions (mechanism is OD-17)
VEYLIX_SESSION_SECRET_KEY=change-me
# Key for pseudonymous audit identifiers (SRS DR-064, DEC-03).
# The backend refuses to start without it (SAD 9.4).
VEYLIX_AUDIT_PSEUDONYM_KEY=change-me

# ---------- Input limits (PRD v1.2 initial values) ----------
VEYLIX_MAX_URL_LENGTH=2048
VEYLIX_MAX_EMAIL_LENGTH=50000
VEYLIX_MAX_EMBEDDED_URLS=20
VEYLIX_HISTORY_MAX_PAGE_SIZE=100
# Maximum scan request body size in bytes (128 KB, API spec v0.1)
VEYLIX_MAX_SCAN_BODY_BYTES=131072

# ---------- Data retention ----------
VEYLIX_SCAN_RETENTION_DAYS=90
# Proposed value, pending confirmation (OD-20)
VEYLIX_AUDIT_RETENTION_DAYS=365

# ---------- ML model artifacts (trusted local paths only, SRS MLI-005) ----------
VEYLIX_URL_MODEL_DIR=ml/models/url
VEYLIX_EMAIL_MODEL_DIR=ml/models/email

# ---------- Rate limiting (values not decided yet, OD-07) ----------
VEYLIX_LOGIN_RATE_LIMIT=
VEYLIX_SCAN_RATE_LIMIT=
